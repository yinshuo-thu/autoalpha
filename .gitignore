# AutoAlpha v3 source-control policy:
# keep implementation files, configs, docs, and lightweight reports in Git;
# keep local data, generated submissions, caches, credentials, model outputs,
# and built artifacts out of Git.

# Secrets / local config
.env
.env.*
!.env.example
*.pem
*.key
*_key*
*_secret*
secrets/

# Python environments and caches
.venv/
venv/
.conda/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node / frontend generated assets
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/

